#!/bin/bash
# SPDX-License-Identifier: MIT
# What a build that ships must not hold: a way to write to a phone anywhere
# but the command-line tool's `install --write`, and the pretend phone with
# the test key it trusts.
#
#   tools/check-shipping            the sources. Builds nothing, runs nothing
#   tools/check-shipping --built [--control FAKE_PHONE_TOOL]
#                                   also what was built: target/release/omamobile-install
#                                   (cargo build --release --locked, no features) and web/dist
#                                   (web/build.sh, no argument)
#   tools/check-shipping --preview  the sources, and the web page's write preview as built:
#                                   web/dist-preview (web/build.sh web-write-preview). The
#                                   other way round: it must hold the page's write path, and
#                                   say so, and hold no pretend phone and no test key
#
# No mode runs the command-line tool or opens a USB device. The built tool
# is read as bytes. The page's module is loaded in node, which has no USB,
# and asked what it exports; of the preview's module one function is called,
# the one that returns the sentence the build says of itself.
#
# --control names a tool built with the `fake-phone` feature (the tests
# leave one at target/debug/omamobile-install): the strings looked for in
# the shipping tool must be found in that one, or the look proves nothing.
#
# The web page ends at a dry run. The command-line tool has the one write
# path, `install --write`, and the checks for it here were changed with it,
# on purpose and in the same pull request: the flow opens one writing
# session, in the one function that checks every condition for a write, and
# the tool sets the flow's write switch in one place, from `--write` alone.
#
# That a session writes only if `Flow::begin_write` opened it is held by
# the compiler, not by this script: a writing session takes a token
# (`flow::WriteToken`) whose one field is private to the flow's module, and
# the function that takes it is not public (the core's doctests show that
# making a token does not compile). What this script adds is what types do
# not say: that inside the flow's own module the token is made once, in
# `begin_write`, and that nobody widened the two declarations.
# When the page is given a write path, by the maintainer's decision, its
# checks are changed the same way; they are not to be loosened to let
# something through.
#
# The page's write preview (docs/WEB-WRITE.md) is not that decision. It is
# a second build of the page, made only with the cargo feature
# `web-write-preview` and into its own directory, for an attended test. The
# page that ships is checked as before, and in addition for the preview:
# its two source files are compiled only with the feature, nothing outside
# them names them without it, the feature is no default, the directory that
# every build's page is copied from holds none of its scripts, and the
# shipping module and page hold none of its code, its exports or its words.
# The preview has no session of its own either: its one way to a write is
# the flow's `begin_write`, like the command-line tool's.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
export LC_ALL=C
control=
built=0
preview=0
while (( $# )); do
  case $1 in
    --built) built=1 ;;
    --preview) preview=1 ;;
    --control) control=${2:?--control takes a file}; shift ;;
    *) echo "usage: tools/check-shipping [--built [--control FAKE_PHONE_TOOL]] [--preview]" >&2; exit 2 ;;
  esac
  shift
done
# The write preview's sources: compiled, and copied into a build, only for
# the cargo feature of that name. Everything else under web/ is the page
# that ships (and its self-test)
preview_feature='web-write-preview'
preview_rs=(web/src/webusb.rs web/src/write_preview.rs)
shipping_rs=()
for f in web/src/*.rs; do
  case " ${preview_rs[*]} " in *" $f "*) ;; *) shipping_rs+=("$f") ;; esac
done
preview_page=(web/preview/index.html web/preview/preview.js web/preview/write-walk.js)
preview_tests=(web/preview/test/*)

fail=0
ok() { printf 'ok - %s\n' "$1"; }
bad() { printf 'not ok - %s\n' "$1"; shift; (( $# )) && printf '%s\n' "$@"; fail=1; }
# none WHAT PCRE FILE...: no line of the files matches
none() {
  local what=$1 pattern=$2 found; shift 2
  found=$(grep -nHP -- "$pattern" "$@" /dev/null || true)
  if [[ -n $found ]]; then bad "$what" "$found"; else ok "$what"; fi
}
# once WHAT FIXED FILE: exactly one line of the file holds the string
once() {
  local n; n=$(grep -cF -- "$2" "$3" || true)
  if [[ $n == 1 ]]; then ok "$1"; else bad "$1" "$3 holds '$2' $n times, not once"; fi
}

# ---- The sources ----------------------------------------------------------

# The switch that once made the page's direct session write is gone, with
# that session: nothing names it
feature='enable-''writes'
none "nothing names the web page's old write switch" "$feature|enable_writes" \
  web/Cargo.toml web/src/*.rs web/static/* web/build.sh web/selftest.sh web/serve.py \
  "${preview_page[@]}" "${preview_tests[@]}" web/preview-test.sh \
  cli/Cargo.toml core/Cargo.toml usb/Cargo.toml .cargo/config.toml .github/workflows/*.yml

# A session that writes takes a token only the flow's module can make. The
# two declarations that the compiler holds everyone else to:
once "the write token's one field is private to the flow's module" \
  "pub struct WriteToken(());" core/src/flow.rs
none "the write token can't be cloned, copied or made by default" \
  '^#\[derive\(' <(grep -B3 '^pub struct WriteToken' core/src/flow.rs)
once "the function that opens a writing session is not public" \
  "pub(crate) async fn connect_writing(" core/src/fastboot.rs
none "no session option says whether a session writes" \
  '^\s*pub dry_run\b' core/src/fastboot.rs
# in_fn FILE PCRE: each matching line, with the function it is in
in_fn() {
  awk -v pattern="$2" '
    /^ *(pub )?(pub\(crate\) )?(async )?fn [a-z_]+/ { at = $0 }
    $0 ~ pattern && $0 !~ /^pub struct / && $0 !~ /^ *\/\// { print FILENAME ":" FNR ": in: " at }
  ' "$1"
}
# Inside the flow's module, where the field can be reached: made once, in
# the one function that checks every condition for a write, and handed to
# the one call that opens a writing session
minted=$(in_fn core/src/flow.rs 'WriteToken[(][(][)][)]')
if [[ $(printf '%s\n' "$minted" | grep -c .) == 1 && $minted == *"pub async fn begin_write<"* ]]; then
  ok "the flow makes one write token, in begin_write"
else
  bad "the flow makes a write token outside begin_write, or none" "$minted"
fi
writers=$(in_fn core/src/flow.rs 'connect_writing[(]')
if [[ $(printf '%s\n' "$writers" | grep -c .) == 1 && $writers == *"pub async fn begin_write<"* ]]; then
  ok "the flow opens one writing session, in begin_write"
else
  bad "the flow opens a writing session outside begin_write, or none" "$writers"
fi
dry=$(in_fn core/src/flow.rs 'Session::connect(_pinned)?[(]')
if [[ $(printf '%s\n' "$dry" | grep -c .) == 1 && $dry == *"pub async fn dry_run<"* ]]; then
  ok "the flow's other session is the dry run's, which can't write"
else
  bad "the flow opens a session somewhere else than dry_run and begin_write" "$dry"
fi
# The flow's unit tests are a child of its module and can make a token (they
# test the writing session's own refusals). They are test code only
gated=$(grep -B1 -n '^mod tests;' core/src/flow.rs | grep -c '#\[cfg(test)\]' || true)
[[ $gated == 1 ]] && ok "the flow's unit tests, which can make a token, are built only for tests" ||
  bad "core/src/flow.rs has a tests module that is not behind cfg(test)"
# Nowhere else is a token made or a writing session opened: not elsewhere
# in the core, and not in a front end (where neither would compile)
elsewhere=$(grep -rnE 'WriteToken\(\(\)\)|connect_writing' core/src cli/src web/src usb/src web/static web/preview |
  grep -vE '^core/src/flow\.rs:|^core/src/flow/tests\.rs:|^core/src/fastboot\.rs:[0-9]+: *(///|//|pub\(crate\) async fn connect_writing\()' || true)
if [[ -z $elsewhere ]]; then ok "no token is made and no writing session opened anywhere else"
else bad "a write token or a writing session outside the flow" "$elsewhere"; fi

# The command-line tool: its only sessions are the ones the core's flow
# opens
none "the command-line tool opens no session of its own and names no session options" \
  'Session::connect|connect_pinned|connect_writing|PhoneOptions|WriteToken' cli/src/*.rs
switches=$(grep -nP '\bwrite *: *true|\.write *= *(?!false)' cli/src/*.rs core/src/*.rs usb/src/*.rs "${shipping_rs[@]}" /dev/null || true)
if [[ $switches == "cli/src/main.rs:"*"options.write = write;" ]]; then
  ok "in what ships, the flow's write switch is set in one place, by the command-line tool, from --write"
else
  bad "the flow's write switch is set somewhere else than the command-line tool's one line" "$switches"
fi
once "--write is the one argument that sets it" '"--write" => write = true,' cli/src/main.rs

# The page: it begins every flow as a dry run and reaches none of the
# flow's write steps
none "the page and its script reach none of the flow's write steps" \
  'confirm_install|begin_write|write_done|write_failed|write_path' "${shipping_rs[@]}" web/static/*
once "the page begins every flow with the write switch off" "write: false," web/src/lib.rs
# The owner's statement about the other bootloader slot is the command
# line's: typed there, by the owner. The page's source never names it
none "the page cannot state the other bootloader slot's version for its owner, in any build" \
  'bootloader_slots_match|slots[-_]match' web/src/*.rs web/static/* "${preview_page[@]}" "${preview_tests[@]}"
once "the command-line tool takes that statement from one argument" \
  'options.bootloader_slots_match = Some(' cli/src/main.rs
# The page: no session that writes, in any build. Its self-test walks an
# install against the pretend phone through a session it opens directly,
# which is a dry run, and exists only in a self-test build
none "the page's module names no write token and no writing session" \
  'WriteToken|connect_writing|dry_run *: *false' web/src/*.rs
selftest_gate=$(grep -B2 -n '^pub async fn selftest()' web/src/lib.rs | grep -c '#\[cfg(feature = "selftest")\]' || true)
[[ $selftest_gate == 1 ]] && ok "the page's self-test function is built only with the selftest feature" ||
  bad "the page's self-test function is not behind the selftest feature"
none "the page's module has no direct session for the page to drive" \
  '^pub struct Install\b|^pub async fn connect\(|fn writes_enabled' web/src/lib.rs
none "the page's script calls nothing of the direct session" \
  'core\.connect\(|\.flash_boot\(|\.userdata_(start|feed|end)\(|\.finish\(|new core\.Install\b' web/static/*.js

# The pretend phone: compiled in only behind its feature, in each front end
for pair in "cli/src/main.rs|fake-phone" "web/src/lib.rs|selftest"; do
  file=${pair%%|*} feature_name=${pair#*|}
  gated=$(grep -B2 -n '^mod fake;' "$file" | grep -c "#\[cfg(feature = \"$feature_name\")\]" || true)
  mods=$(grep -c '^mod fake;' "$file" || true)
  if [[ $mods == 1 && $gated == 1 ]]; then ok "$file builds the pretend phone only with the $feature_name feature"
  else bad "$file builds the pretend phone without its feature ($mods mod fake, $gated behind $feature_name)"; fi
done
none "no feature that brings the pretend phone or the test key is a default" \
  '^default *=.*(fake-phone|selftest)' cli/Cargo.toml web/Cargo.toml

# The page's write preview: a second build, never the one that ships
for file in "${preview_rs[@]}"; do
  name=$(basename "$file" .rs)
  mods=$(grep -c "^mod $name;" web/src/lib.rs || true)
  gated=$(grep -B1 -n "^mod $name;" web/src/lib.rs | grep -c "#\[cfg(feature = \"$preview_feature\")\]" || true)
  if [[ -f $file && $mods == 1 && $gated == 1 ]]; then ok "$file is compiled only with the $preview_feature feature"
  else bad "$file is compiled without the $preview_feature feature ($mods mod $name, $gated behind the feature)"; fi
done
# Outside those two files, a line that names something of them stands
# directly under the feature's cfg (comments aside)
loose=$(awk -v gate="#[cfg(feature = \"$preview_feature\")]" '
  { line = $0; sub(/^[ \t]+/, "", line) }
  line ~ /^\/\// { next }
  /webusb::|write_preview::|WebUsb/ && before != gate { print FILENAME ":" FNR ": " $0 }
  { before = line }
' "${shipping_rs[@]}")
if [[ -z $loose ]]; then ok "the page's module names nothing of the write preview without its feature"
else bad "the page's module names something of the write preview outside the feature" "$loose"; fi
none "the write preview's feature is no default" \
  "^default *=.*$preview_feature" web/Cargo.toml cli/Cargo.toml core/Cargo.toml usb/Cargo.toml
once "the write preview's feature is declared once, in the page's crate" "$preview_feature = [" web/Cargo.toml
# Its one way to a write is the flow's, as for the command-line tool
none "the write preview opens no session of its own and names no session options" \
  'Session::connect|connect_pinned|PhoneOptions' "${preview_rs[@]}"
none "the write preview has no command and no partition name of its own" \
  '"(getvar|download|flash|erase|format|oem|flashing|set_active|reboot|continue|boot)[: "]' "${preview_rs[@]}"
opens=$(grep -c '\.begin_write(' web/src/write_preview.rs || true)
switch=$(grep -nP '\bwrite *: *true|\.write *= *(?!false)' "${preview_rs[@]}" /dev/null || true)
if [[ $opens == 1 && $switch == "web/src/write_preview.rs:"*"options.write = true;" ]]; then
  ok "the write preview sets the flow's write switch in one line and asks the flow for its writing session in one place"
else
  bad "the write preview sets the write switch or asks for a writing session in more than one place, or in none" "$opens begin_write" "$switch"
fi
once "the write preview begins its flows from the options of the page that ships" \
  "let mut options = super::page_options(reinstall);" web/src/write_preview.rs
# Its scripts: not in the directory every build's page is copied from
strays=$(ls web/static | grep -vxE 'app\.js|index\.html|style\.css' || true)
if [[ -z $strays ]]; then ok "the page that ships is three files, and none is the write preview's"
else bad "web/static holds more than the page that ships" "$strays"; fi
none "the page that ships loads no script but its own, and names none of the write preview's" \
  'preview\.js|write-walk|page-run|fake-usb|web_write|session_(open|boot|root|finish)|images_(check|root)' web/static/*
tags=$(grep -c '<script' web/static/index.html || true)
if [[ $tags == 1 ]] && grep -qF '<script type="module" src="app.js"></script>' web/static/index.html; then
  ok "the page that ships has one script tag, its own"
else bad "the page that ships has $tags script tags, or its one is not app.js"; fi
none "the write preview's page offers no override and runs no command" \
  'maintainer|slot_override|flashing unlock|fake_phone' "${preview_page[@]}"
once "a build that is not the write preview copies none of its scripts" \
  'cp "$here"/preview/index.html "$here"/preview/*.js "$dist/"' web/build.sh
none "the self-test of the page that ships is not built with the write preview" \
  "$preview_feature" web/selftest.sh

# ---- What was built -------------------------------------------------------

# What only a build with the write preview holds: the sentence it says of
# itself, its exports, and its transport's words
preview_marks=("this build can write to a phone" "web_write_preview" "begin_write_preview" "session_root_feed"
  "the connection to the phone ended earlier" "timed out waiting for the phone")
preview_glue='preview|web_write|session_(open|boot|root_feed|finish|abandon|progress)|images_(check_boot|root_(begin|update|done))'

if (( built )); then
  # What only a build with the pretend phone holds: its serial numbers, its
  # bootloader version, the test key's file, and the line it starts with
  marks=("FAKESERIAL0001" "ANOTHERPHONE0002" "fake-1.0" "test-key.gpg" "A pretend phone (")
  holds() { grep -qaF -- "$2" "$1"; }

  tool=target/release/omamobile-install
  if [[ ! -f $tool ]]; then
    bad "there is no $tool to read (cargo build --release --locked)"
  else
    found=()
    for mark in "${marks[@]}"; do if holds "$tool" "$mark"; then found+=("$mark"); fi; done
    if (( ${#found[@]} )); then bad "the shipping tool holds the pretend phone" "${found[@]}"
    else ok "the shipping tool holds nothing of the pretend phone or the test key"; fi
    # The refusals a shipping tool answers with are in it
    for says in "this build has no pretend phone" "install needs --dry-run or --write, and has no default"; do
      if holds "$tool" "$says"; then ok "the shipping tool holds the refusal '$says'"
      else bad "the shipping tool does not hold the refusal '$says'"; fi
    done
  fi
  if [[ -n $control ]]; then
    missing=()
    [[ -f $control ]] || missing=("no such file")
    for mark in "${marks[@]}"; do if [[ -f $control ]] && ! holds "$control" "$mark"; then missing+=("$mark"); fi; done
    if (( ${#missing[@]} )); then bad "the control, $control, is not a tool with the pretend phone, so the look above proves nothing" "${missing[@]}"
    else ok "the control, a tool built with the pretend phone, holds every one of those strings"; fi
  fi

  pkg=web/dist/pkg
  glue=$pkg/omamobile_installer_web.js
  wasm=$pkg/omamobile_installer_web_bg.wasm
  if [[ ! -f $glue || ! -f $wasm || ! -f web/dist/index.html ]]; then
    bad "there is no shipping page in web/dist to read (web/build.sh)"
  else
    found=()
    for mark in "${marks[@]}"; do if holds "$wasm" "$mark"; then found+=("$mark"); fi; done
    if (( ${#found[@]} )); then bad "the shipping page's module holds the pretend phone" "${found[@]}"
    else ok "the shipping page's module holds nothing of the pretend phone or the test key"; fi
    none "the shipping page's glue has no pretend phone, no self-test and no override" \
      'fake_phone|selftest|slot_override|maintainer|slots_match' "$glue"
    none "what the shipping page loads has none of the flow's write steps" \
      'confirm_install|begin_write|write_done|write_failed' "$glue" web/dist/*.js web/dist/*.html
    found=()
    for mark in "${preview_marks[@]}"; do if holds "$wasm" "$mark"; then found+=("$mark"); fi; done
    if (( ${#found[@]} )); then bad "the shipping page's module holds the write preview" "${found[@]}"
    else ok "the shipping page's module holds nothing of the write preview: not its transport, not its steps, not its words"; fi
    none "the shipping page's glue has nothing of the write preview" "$preview_glue" "$glue"
    strays=$(cd web/dist && find . -type f ! -path './pkg/*' ! -path './release/*' | sort | tr '\n' ' ')
    if [[ $strays == "./app.js ./index.html ./style.css " ]]; then ok "the shipping page is its three files, the module and the release's files"
    else bad "the shipping page holds other files than its own" "$strays"; fi
    if grep -qF 'cannot write to a phone' web/dist/index.html; then ok "the shipping page says it cannot write to a phone"
    else bad "the shipping page does not say that it cannot write to a phone"; fi
    if ! command -v node >/dev/null; then
      bad "node is needed to load the page's module and ask whether it can write"
    else
      # Loaded in node, which has no USB; the module's exports are listed, and
      # nothing of it is called
      scratch=$(mktemp -d)
      trap 'rm -rf "$scratch"' EXIT
      cp "$glue" "$scratch/glue.mjs"
      cat >"$scratch/ask.mjs" <<'JS'
import { readFileSync } from "node:fs";
const glue = await import("./glue.mjs");
glue.initSync({ module: readFileSync(process.argv[2]) });
const names = Object.keys(glue).sort();
const extra = names.filter((n) => /fake|selftest|pretend/i.test(n));
const statics = Object.getOwnPropertyNames(glue.InstallFlow).filter((n) => /selftest|fake/i.test(n));
const direct = names.filter((n) => /^(connect|Install|RootProof|writes_enabled)$/.test(n));
const steps = Object.getOwnPropertyNames(glue.InstallFlow.prototype);
const preview = [...names, ...steps, ...Object.getOwnPropertyNames(glue.InstallFlow)].filter((n) => /preview|web_write|confirm_install|session_|images_/i.test(n));
console.log(JSON.stringify({ direct, extra, statics, preview, names }));
JS
      answer=$(node "$scratch/ask.mjs" "$PWD/$wasm" 2>&1) || true
      if [[ $answer == '{"direct":[],"extra":[],"statics":[],"preview":[],"names":['*'"InstallFlow"'* ]]; then
        ok "the shipping page's module, loaded, exports the flow, no direct session, no pretend phone, no self-test and nothing of the write preview"
      else
        bad "the shipping page's module, loaded, exports a direct session, a pretend phone or the write preview, or did not load" "$answer"
      fi
    fi
  fi
fi

# ---- The write preview, as built ------------------------------------------

# The other way round: this build must hold the page's write path, and say
# so, or the checks above that look for it in the shipping build prove
# nothing. It is still no build for a pretend phone or a test key.
if (( preview )); then
  marks=("FAKESERIAL0001" "ANOTHERPHONE0002" "fake-1.0" "test-key.gpg" "A pretend phone (")
  holds() { grep -qaF -- "$2" "$1"; }
  dist=web/dist-preview
  glue=$dist/pkg/omamobile_installer_web.js
  wasm=$dist/pkg/omamobile_installer_web_bg.wasm
  if [[ ! -f $glue || ! -f $wasm || ! -f $dist/index.html ]]; then
    bad "there is no write preview in $dist to read (web/build.sh $preview_feature)"
  else
    missing=()
    for mark in "${preview_marks[@]}"; do if ! holds "$wasm" "$mark"; then missing+=("$mark"); fi; done
    if (( ${#missing[@]} )); then bad "the write preview's module does not hold the write preview" "${missing[@]}"
    else ok "the write preview's module holds its transport, its steps and what it says of itself"; fi
    found=()
    for mark in "${marks[@]}"; do if holds "$wasm" "$mark"; then found+=("$mark"); fi; done
    if (( ${#found[@]} )); then bad "the write preview's module holds the pretend phone" "${found[@]}"
    else ok "the write preview's module holds nothing of the pretend phone or the test key"; fi
    none "the write preview's glue has no pretend phone, no self-test and no override" \
      'fake_phone|selftest|slot_override|maintainer|slots_match' "$glue"
    strays=$(cd "$dist" && find . -type f ! -path './pkg/*' ! -path './release/*' | sort | tr '\n' ' ')
    if [[ $strays == "./app.js ./index.html ./preview.js ./style.css ./write-walk.js " ]]; then ok "the write preview is the page's files and its own three, with none of its tests"
    else bad "the write preview holds other files than the page's and its own" "$strays"; fi
    if grep -qF 'this build can write to a phone' "$dist/index.html" && grep -qF 'It has never been run against a real phone' "$dist/index.html" &&
      ! grep -qF 'cannot write to a phone' "$dist/index.html"; then
      ok "the write preview's first page says that it can write to a phone and has never met a real one"
    else bad "the write preview's first page does not say plainly what it is"; fi
    tags=$(grep -c '<script' "$dist/index.html" || true)
    if [[ $tags == 1 ]] && grep -qF '<script type="module" src="preview.js"></script>' "$dist/index.html"; then
      ok "the write preview's first page loads its own script, which loads the page's"
    else bad "the write preview's first page has $tags script tags, or its one is not preview.js"; fi
    if ! command -v node >/dev/null; then
      bad "node is needed to load the write preview's module and ask what it exports"
    else
      scratch2=$(mktemp -d)
      trap 'rm -rf "${scratch:-}" "$scratch2"' EXIT
      cp "$glue" "$scratch2/glue.mjs"
      cat >"$scratch2/ask.mjs" <<'JS'
import { readFileSync } from "node:fs";
const glue = await import("./glue.mjs");
glue.initSync({ module: readFileSync(process.argv[2]) });
const names = Object.keys(glue).sort();
const steps = Object.getOwnPropertyNames(glue.InstallFlow.prototype);
const makers = Object.getOwnPropertyNames(glue.InstallFlow);
const has = ["request_phone", "web_write_preview"].every((n) => names.includes(n)) &&
  makers.includes("begin_write_preview") &&
  ["confirm_install", "images_check_boot", "images_root_begin", "images_root_update", "images_root_done",
    "session_open", "session_boot", "session_root_feed", "session_finish", "session_abandon"].every((n) => steps.includes(n));
const extra = [...names, ...steps, ...makers].filter((n) => /fake|selftest|pretend|slot|override|maintainer|unlock|command|partition|token/i.test(n));
// The one call: a sentence, made of nothing but the module's own words
const says = glue.web_write_preview();
console.log(JSON.stringify({ has, extra, says }));
JS
      answer=$(node "$scratch2/ask.mjs" "$PWD/$wasm" 2>&1) || true
      if [[ $answer == '{"has":true,"extra":[],"says":"This is a write preview, made for an attended test and not for use. Unlike the page that ships, this build can write to a phone'*'It has never been run against a real phone."}' ]]; then
        ok "the write preview's module, loaded, exports the chooser, the flow's write steps and what it says of itself, and no pretend phone, self-test, override or slot statement"
      else
        bad "the write preview's module, loaded, lacks the write steps or exports something it must not, or did not load" "$answer"
      fi
    fi
  fi
fi
exit "$fail"
