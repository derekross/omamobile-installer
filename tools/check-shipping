#!/bin/bash
# SPDX-License-Identifier: MIT
# What a build that ships must not hold: a way to write to a phone anywhere
# but the command-line tool started with `--write` (`install --write`, and
# `json --write`, which the desktop app starts when it was itself started
# with `--write`), and the pretend phone with the test key it trusts.
#
#   tools/check-shipping            the sources. Builds nothing, runs nothing
#   tools/check-shipping --built [--control FAKE_PHONE_TOOL]
#                                   also what was built: target/release/omamobile-install
#                                   (cargo build --release --locked, no features) and web/dist
#                                   (web/build.sh, no argument); and the desktop
#                                   app, app/build/omainstall, if app/bin/build made one
#
# Neither mode runs the command-line tool or opens a USB device. The built
# tool is read as bytes. The page's module is loaded in node, which has no
# USB, and asked what it exports.
#
# --control names a tool built with the `fake-phone` feature (the tests
# leave one at target/debug/omamobile-install): the strings looked for in
# the shipping tool must be found in that one, or the look proves nothing.
#
# The web page ends at a dry run. The command-line tool has the one write
# path, `install --write`, and the checks for it here were changed with it,
# on purpose and in the same pull request: the flow opens one writing
# session, in the one function that checks every condition for a write, and
# the tool sets the flow's write switch from `--write` alone.
#
# Changed again, on purpose, with the tool's `json` mode given the same
# path for the desktop app (protocol 2, docs/APP.md): the switch is now set
# in two places and no third, `install`'s arguments and `json`'s, each from
# the word `--write` on the tool's own command line and from nothing a
# message says. The owner's statement about a bootloader slot stays
# `install`'s alone. The app's sources are read too: it passes `--write`
# on only when it was started with it, and holds no pretend phone.
#
# That a session writes only if `Flow::begin_write` opened it is held by
# the compiler, not by this script: a writing session takes a token
# (`flow::WriteToken`) whose one field is private to the flow's module, and
# the function that takes it is not public (the core's doctests show that
# making a token does not compile). What this script adds is what types do
# not say: that inside the flow's own module the token is made once, in
# `begin_write`, and that nobody widened the two declarations.
# When the page is given a write path, by the maintainer's decision, its
# checks are changed the same way; they are not to be loosened to let
# something through.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
export LC_ALL=C
control=
built=0
while (( $# )); do
  case $1 in
    --built) built=1 ;;
    --control) control=${2:?--control takes a file}; shift ;;
    *) echo "usage: tools/check-shipping [--built [--control FAKE_PHONE_TOOL]]" >&2; exit 2 ;;
  esac
  shift
done

fail=0
ok() { printf 'ok - %s\n' "$1"; }
bad() { printf 'not ok - %s\n' "$1"; shift; (( $# )) && printf '%s\n' "$@"; fail=1; }
# none WHAT PCRE FILE...: no line of the files matches
none() {
  local what=$1 pattern=$2 found; shift 2
  found=$(grep -nHP -- "$pattern" "$@" /dev/null || true)
  if [[ -n $found ]]; then bad "$what" "$found"; else ok "$what"; fi
}
# once WHAT FIXED FILE: exactly one line of the file holds the string
once() {
  local n; n=$(grep -cF -- "$2" "$3" || true)
  if [[ $n == 1 ]]; then ok "$1"; else bad "$1" "$3 holds '$2' $n times, not once"; fi
}

# ---- The sources ----------------------------------------------------------

# The switch that once made the page's direct session write is gone, with
# that session: nothing names it
feature='enable-''writes'
none "nothing names the web page's old write switch" "$feature|enable_writes" \
  web/Cargo.toml web/src/*.rs web/static/* web/build.sh web/selftest.sh web/serve.py \
  cli/Cargo.toml core/Cargo.toml usb/Cargo.toml .cargo/config.toml .github/workflows/*.yml

# A session that writes takes a token only the flow's module can make. The
# two declarations that the compiler holds everyone else to:
once "the write token's one field is private to the flow's module" \
  "pub struct WriteToken(());" core/src/flow.rs
none "the write token can't be cloned, copied or made by default" \
  '^#\[derive\(' <(grep -B3 '^pub struct WriteToken' core/src/flow.rs)
once "the function that opens a writing session is not public" \
  "pub(crate) async fn connect_writing(" core/src/fastboot.rs
none "no session option says whether a session writes" \
  '^\s*pub dry_run\b' core/src/fastboot.rs
# in_fn FILE PCRE: each matching line, with the function it is in
in_fn() {
  awk -v pattern="$2" '
    /^ *(pub )?(pub\(crate\) )?(async )?fn [a-z_]+/ { at = $0 }
    $0 ~ pattern && $0 !~ /^pub struct / && $0 !~ /^ *\/\// { print FILENAME ":" FNR ": in: " at }
  ' "$1"
}
# Inside the flow's module, where the field can be reached: made once, in
# the one function that checks every condition for a write, and handed to
# the one call that opens a writing session
minted=$(in_fn core/src/flow.rs 'WriteToken[(][(][)][)]')
if [[ $(printf '%s\n' "$minted" | grep -c .) == 1 && $minted == *"pub async fn begin_write<"* ]]; then
  ok "the flow makes one write token, in begin_write"
else
  bad "the flow makes a write token outside begin_write, or none" "$minted"
fi
writers=$(in_fn core/src/flow.rs 'connect_writing[(]')
if [[ $(printf '%s\n' "$writers" | grep -c .) == 1 && $writers == *"pub async fn begin_write<"* ]]; then
  ok "the flow opens one writing session, in begin_write"
else
  bad "the flow opens a writing session outside begin_write, or none" "$writers"
fi
dry=$(in_fn core/src/flow.rs 'Session::connect(_pinned)?[(]')
if [[ $(printf '%s\n' "$dry" | grep -c .) == 1 && $dry == *"pub async fn dry_run<"* ]]; then
  ok "the flow's other session is the dry run's, which can't write"
else
  bad "the flow opens a session somewhere else than dry_run and begin_write" "$dry"
fi
# The flow's unit tests are a child of its module and can make a token (they
# test the writing session's own refusals). They are test code only
gated=$(grep -B1 -n '^mod tests;' core/src/flow.rs | grep -c '#\[cfg(test)\]' || true)
[[ $gated == 1 ]] && ok "the flow's unit tests, which can make a token, are built only for tests" ||
  bad "core/src/flow.rs has a tests module that is not behind cfg(test)"
# Nowhere else is a token made or a writing session opened: not elsewhere
# in the core, and not in a front end (where neither would compile)
elsewhere=$(grep -rnE 'WriteToken\(\(\)\)|connect_writing' core/src cli/src web/src usb/src web/static |
  grep -vE '^core/src/flow\.rs:|^core/src/flow/tests\.rs:|^core/src/fastboot\.rs:[0-9]+: *(///|//|pub\(crate\) async fn connect_writing\()' || true)
if [[ -z $elsewhere ]]; then ok "no token is made and no writing session opened anywhere else"
else bad "a write token or a writing session outside the flow" "$elsewhere"; fi

# The command-line tool: its only sessions are the ones the core's flow
# opens
none "the command-line tool opens no session of its own and names no session options" \
  'Session::connect|connect_pinned|connect_writing|PhoneOptions|WriteToken' cli/src/*.rs
switches=$(grep -nP '\bwrite *: *true|\.write *= *(?!false)' cli/src/*.rs core/src/*.rs usb/src/*.rs web/src/*.rs /dev/null |
  sed -E 's/^([^:]+):[0-9]+: */\1: /' || true)
wanted='cli/src/json.rs: "--write" => out.write = true,
cli/src/main.rs: options.write = write;'
if [[ $switches == "$wanted" ]]; then
  ok "the flow's write switch is set by the command-line tool alone, in install's arguments and in json's, from --write"
else
  bad "the flow's write switch is set somewhere else than the command-line tool's two lines" "$switches"
fi
once "--write is the one argument of install that sets it" '"--write" => write = true,' cli/src/main.rs
# The JSON mode (the desktop app's and scripts' way in): its flow writes
# only if the tool itself was started with --write. No message carries the
# switch, and the one place the mode makes a flow's options reads the
# argument
once "the JSON mode begins its flow with the switch its own --write set" \
  'write: self.may_write,' cli/src/json.rs
once "the JSON mode's switch comes from its arguments, in one line" \
  'may_write: args.write,' cli/src/json.rs
none "the JSON mode sets the flow's write switch nowhere else" \
  '^\s*write: (?!self\.may_write,|bool,)|may_write *=[^=]|may_write\s*:(?!\s*(args\.write,|bool,))' cli/src/json.rs
none "no message of the JSON mode is read for a write switch" \
  'get\("write"\)|"write" *=> *(true|.*as_bool)|message\["write"\]' cli/src/json.rs
# The owner's statement about the other bootloader slot, and the
# maintainer's override, are `install`'s: the JSON mode names neither
none "the JSON mode cannot state the other bootloader slot's version or skip its check" \
  'bootloader_slots_match|maintainer_skip_bootloader_slot_check' cli/src/json.rs

# The page: it begins every flow as a dry run and reaches none of the
# flow's write steps
none "the page and its script reach none of the flow's write steps" \
  'confirm_install|begin_write|write_done|write_failed|write_path' web/src/*.rs web/static/*
once "the page begins every flow with the write switch off" "write: false," web/src/lib.rs
# The owner's statement about the other bootloader slot is the command
# line's: typed there, by the owner. The page's source never names it
none "the page cannot state the other bootloader slot's version for its owner" \
  'bootloader_slots_match|slots[-_]match' web/src/*.rs web/static/*
once "the command-line tool takes that statement from one argument" \
  'options.bootloader_slots_match = Some(' cli/src/main.rs
# The page: no session that writes, in any build. Its self-test walks an
# install against the pretend phone through a session it opens directly,
# which is a dry run, and exists only in a self-test build
none "the page's module names no write token and no writing session" \
  'WriteToken|connect_writing|dry_run *: *false' web/src/*.rs
selftest_gate=$(grep -B2 -n '^pub async fn selftest()' web/src/lib.rs | grep -c '#\[cfg(feature = "selftest")\]' || true)
[[ $selftest_gate == 1 ]] && ok "the page's self-test function is built only with the selftest feature" ||
  bad "the page's self-test function is not behind the selftest feature"
none "the page's module has no direct session for the page to drive" \
  '^pub struct Install\b|^pub async fn connect\(|fn writes_enabled' web/src/lib.rs
none "the page's script calls nothing of the direct session" \
  'core\.connect\(|\.flash_boot\(|\.userdata_(start|feed|end)\(|\.finish\(|new core\.Install\b' web/static/*.js

# The desktop app (app/src): it starts the tool's JSON mode and draws what
# it is sent. It passes --write on only when it was itself started with
# --write, has no message that carries the switch, and names neither the
# slot statement, the override nor a pretend phone
# (cli.cpp's lines are its usage text, which names the argument and passes nothing)
app_write=$(grep -n -- '--write' app/src/*.cpp app/src/*.h app/src/*.qml /dev/null | grep -vE '^app/src/cli\.cpp:|^[^:]+:[0-9]+: *//' |
  sed -E 's/^([^:]+):[0-9]+: */\1: /' || true)
wanted='app/src/backend.cpp: arguments << "--write";
app/src/main.cpp: } else if (argument == "--write") {'
if [[ $app_write == "$wanted" ]]; then
  ok "the app passes --write to the tool in one line, and takes it from its own command line in one"
else
  bad "the app names --write somewhere else than its argument and the tool's" "$app_write"
fi
guarded=$(grep -B1 -F 'arguments << "--write";' app/src/backend.cpp | head -1)
if [[ $guarded == *"if (m_write && !probeOnly)" ]]; then
  ok "the app passes --write only when it was started with it, and never for a probe"
else
  bad "the line that passes --write to the tool is not under the app's own switch" "$guarded"
fi
none "the app's usage text aside, cli.cpp passes nothing to the tool" 'arguments|<< *"--' app/src/cli.cpp
once "the app's write switch is set from its own --write and nothing else" \
  'backend.setWrite(write);' app/src/main.cpp
once "the app's switch starts off" 'bool write = false;' app/src/main.cpp
turned_on=$(grep -hB1 -E '\bwrite *= *true' app/src/*.cpp app/src/*.h | tr -s ' ' | tr '\n' '|')
if [[ $turned_on == ' } else if (argument == "--write") {| write = true;|' ]]; then
  ok "the app's switch is set true in one line, the one that reads --write"
else
  bad "the app's write switch is set true somewhere else than where --write is read" "$turned_on"
fi
none "the app's switch is given nothing but true or false" \
  '\bwrite *=(?! *(true|false);)(?!=)' app/src/main.cpp
setters=$(grep -hoE 'setWrite\([^)]*\)|m_write *= *[^;=]+;' app/src/*.cpp app/src/*.h | sort | tr '\n' ' ')
if [[ $setters == "m_write = false; m_write = write; setWrite(bool write) setWrite(write) " ]]; then
  ok "the app's switch has one setter, called once, and no other line gives it a value"
else
  bad "the app's write switch is given a value somewhere else" "$setters"
fi
none "nothing in the window sets the app's write switch" \
  'setWrite|\.write *= *true|writes *= *true' app/src/*.qml
none "no message the app sends carries a write switch" \
  '"write" *, *(true|m_write|write)\b|"writes" *,' app/src/*.cpp app/src/*.h
none "the app names no bootloader-slot statement, no override, no serial number and no pretend phone" \
  'slots[-_]match|maintainer|--serial|fake[-_]phone|fake[-_]google|fake[-_]unplug' app/src/*.cpp app/src/*.h app/src/*.qml

# The pretend phone: compiled in only behind its feature, in each front end
for pair in "cli/src/main.rs|fake-phone" "web/src/lib.rs|selftest"; do
  file=${pair%%|*} feature_name=${pair#*|}
  gated=$(grep -B2 -n '^mod fake;' "$file" | grep -c "#\[cfg(feature = \"$feature_name\")\]" || true)
  mods=$(grep -c '^mod fake;' "$file" || true)
  if [[ $mods == 1 && $gated == 1 ]]; then ok "$file builds the pretend phone only with the $feature_name feature"
  else bad "$file builds the pretend phone without its feature ($mods mod fake, $gated behind $feature_name)"; fi
done
none "no feature that brings the pretend phone or the test key is a default" \
  '^default *=.*(fake-phone|selftest)' cli/Cargo.toml web/Cargo.toml

# The install link (after a write): the command-line tool and the app have
# it, as they have the write. The page as it ships has neither: the link's
# steps that write to the phone (the answers, the factory image, the
# backup's commit, provisioning, the restart, the end) are reached through
# the core's LinkFlow, which only the page's preview build names, in two
# files behind the link-preview feature. The pretend phone that speaks the
# link is the core's pretend-link feature, which only the test builds turn on.
none "no default feature brings the install link's preview or its pretend phone" \
  '^default *=.*(link-preview|pretend-link)' cli/Cargo.toml web/Cargo.toml core/Cargo.toml
for m in link link_webusb; do
  gated=$(grep -B1 -n "^mod $m;" web/src/lib.rs | grep -c '#\[cfg(feature = "link-preview")\]' || true)
  mods=$(grep -c "^mod $m;" web/src/lib.rs || true)
  if [[ $mods == 1 && $gated == 1 ]]; then ok "the page's module builds $m only with the link-preview feature"
  else bad "web/src/lib.rs builds $m without the link-preview feature ($mods mod $m, $gated behind it)"; fi
done
link_names=$(grep -nE 'LinkFlow|LinkTransport|LinkShell|link_answers|LinkPreview|omamobile_link' web/src/*.rs |
  grep -vE '^web/src/(link|link_webusb)\.rs:' || true)
if [[ -z $link_names ]]; then ok "nothing of the page's module but its two link-preview files names the install link"
else bad "the page's module names the install link outside its link-preview files" "$link_names"; fi
none "the page's link-preview feature brings no pretend phone of its own" \
  '^link-preview *=.*(selftest|pretend-link|fake)' web/Cargo.toml
pretend_gate=$(grep -B1 -n '^pub mod pretend;' core/src/link.rs | grep -c '#\[cfg(feature = "pretend-link")\]' || true)
[[ $pretend_gate == 1 ]] && ok "the core's pretend link phone is built only with the pretend-link feature" ||
  bad "core/src/link.rs builds its pretend phone without the pretend-link feature"
for pair in "cli/Cargo.toml|fake-phone" "web/Cargo.toml|selftest"; do
  file=${pair%%|*} feature_name=${pair#*|}
  if grep -qE "^(\S+ *= *\[.*pretend-link.*\])" "$file" && ! grep -qE "^$feature_name *= *\[.*pretend-link" "$file"; then
    bad "$file turns on the core's pretend-link outside its $feature_name feature"
  else ok "$file turns on the core's pretend-link only with its $feature_name feature"; fi
done

# ---- What was built -------------------------------------------------------

if (( built )); then
  # What only a build with the pretend phone holds: its serial numbers, its
  # bootloader version, the test key's file, and the line it starts with
  marks=("FAKESERIAL0001" "ANOTHERPHONE0002" "fake-1.0" "test-key.gpg" "A pretend phone (" "0.0.1-pretend" "the pretend phone's cable is out")
  holds() { grep -qaF -- "$2" "$1"; }

  tool=target/release/omamobile-install
  if [[ ! -f $tool ]]; then
    bad "there is no $tool to read (cargo build --release --locked)"
  else
    found=()
    for mark in "${marks[@]}"; do if holds "$tool" "$mark"; then found+=("$mark"); fi; done
    if (( ${#found[@]} )); then bad "the shipping tool holds the pretend phone" "${found[@]}"
    else ok "the shipping tool holds nothing of the pretend phone or the test key"; fi
    # The refusals a shipping tool answers with are in it
    for says in "this build has no pretend phone" "install needs --dry-run or --write, and has no default"; do
      if holds "$tool" "$says"; then ok "the shipping tool holds the refusal '$says'"
      else bad "the shipping tool does not hold the refusal '$says'"; fi
    done
  fi
  if [[ -n $control ]]; then
    missing=()
    [[ -f $control ]] || missing=("no such file")
    for mark in "${marks[@]}"; do if [[ -f $control ]] && ! holds "$control" "$mark"; then missing+=("$mark"); fi; done
    if (( ${#missing[@]} )); then bad "the control, $control, is not a tool with the pretend phone, so the look above proves nothing" "${missing[@]}"
    else ok "the control, a tool built with the pretend phone, holds every one of those strings"; fi
  fi

  # The app, when it was built (app/bin/build): read as bytes like the tool
  app=app/build/omainstall
  if [[ -f $app ]]; then
    found=()
    for mark in "${marks[@]}" "--fake-phone" "--fake-unplug" "slots-match"; do if holds "$app" "$mark"; then found+=("$mark"); fi; done
    if (( ${#found[@]} )); then bad "the built app holds a pretend phone or a slot statement" "${found[@]}"
    else ok "the built app holds nothing of the pretend phone, the test key or the slot statement"; fi
  else
    ok "no built app to read (app/bin/build makes app/build/omainstall); its sources were read above"
  fi

  pkg=web/dist/pkg
  glue=$pkg/omamobile_installer_web.js
  wasm=$pkg/omamobile_installer_web_bg.wasm
  if [[ ! -f $glue || ! -f $wasm || ! -f web/dist/index.html ]]; then
    bad "there is no shipping page in web/dist to read (web/build.sh)"
  else
    found=()
    for mark in "${marks[@]}"; do if holds "$wasm" "$mark"; then found+=("$mark"); fi; done
    if (( ${#found[@]} )); then bad "the shipping page's module holds the pretend phone" "${found[@]}"
    else ok "the shipping page's module holds nothing of the pretend phone or the test key"; fi
    none "the shipping page's glue has no pretend phone, no self-test and no override" \
      'fake_phone|selftest|slot_override|maintainer|slots_match' "$glue"
    none "what the shipping page loads has none of the flow's write steps" \
      'confirm_install|begin_write|write_done|write_failed' "$glue" web/dist/*.js web/dist/*.html
    none "the shipping page's glue has nothing of the install link" \
      'LinkPreview|linkpreview|pretend_shows|pretend_report' "$glue"
    if grep -qF 'cannot write to a phone' web/dist/index.html; then ok "the shipping page says it cannot write to a phone"
    else bad "the shipping page does not say that it cannot write to a phone"; fi
    if ! command -v node >/dev/null; then
      bad "node is needed to load the page's module and ask whether it can write"
    else
      # Loaded in node, which has no USB; the module's exports are listed, and
      # nothing of it is called
      scratch=$(mktemp -d)
      trap 'rm -rf "$scratch"' EXIT
      cp "$glue" "$scratch/glue.mjs"
      cat >"$scratch/ask.mjs" <<'JS'
import { readFileSync } from "node:fs";
const glue = await import("./glue.mjs");
glue.initSync({ module: readFileSync(process.argv[2]) });
const names = Object.keys(glue).sort();
const extra = names.filter((n) => /fake|selftest|pretend/i.test(n));
const statics = Object.getOwnPropertyNames(glue.InstallFlow).filter((n) => /selftest|fake/i.test(n));
const direct = names.filter((n) => /^(connect|Install|RootProof|writes_enabled)$/.test(n));
// The install link's preview: no class of it in the page as it ships
const link = names.filter((n) => /link/i.test(n));
console.log(JSON.stringify({ direct, extra, statics, link, names }));
JS
      answer=$(node "$scratch/ask.mjs" "$PWD/$wasm" 2>&1) || true
      if [[ $answer == '{"direct":[],"extra":[],"statics":[],"link":[],"names":['*'"InstallFlow"'* ]]; then
        ok "the shipping page's module, loaded, exports the flow, no direct session, no pretend phone, no self-test and nothing of the install link"
      else
        bad "the shipping page's module, loaded, exports a direct session or a pretend phone, or did not load" "$answer"
      fi
    fi
  fi
fi
exit "$fail"
