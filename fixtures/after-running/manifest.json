      "radio",
      "persist",
      "efs",
      "modem",
      "devinfo",
      "vbmeta",
      "fastboot -w",
      "fastboot --slot",
      "fastboot --set-active",
      "fastboot flashing",
      "fastboot erase",
      "fastboot format",
      "fastboot oem"
