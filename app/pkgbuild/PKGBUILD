# SPDX-License-Identifier: MIT
pkgname=omainstall
pkgver=0.1.0
pkgrel=1
pkgdesc='Guides you through installing Omarchy Mobile on a phone (preview: ends at a dry run)'
arch=('x86_64' 'aarch64')
url='https://github.com/derekross/omamobile-installer'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
# The installer's command-line tool, which the app drives. It is not packaged
# yet; until it is, the app says in its window that the tool was not found.
optdepends=('omamobile-install: the installer itself')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omainstall "$pkgdir/usr/bin/omainstall"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omainstall.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omainstall.svg"
  install -Dm644 "$startdir/omainstall.desktop" "$pkgdir/usr/share/applications/omainstall.desktop"
}
